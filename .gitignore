# External tool binaries (fetched by `aeng setup`)
src/artifact_engine/tools/
tools/

# Geo assets fetched by `aeng setup` (regenerable, large, CC BY, change often)
src/artifact_engine/data/assets/dbip-country-lite.mmdb
src/artifact_engine/data/assets/dbip-asn-lite.mmdb
src/artifact_engine/data/assets/tor-exit-nodes.txt
# The monthly-release stamp `aeng update` leaves beside each mmdb (see _fetch_dbip)
src/artifact_engine/data/assets/*.mmdb.ym

# Community YARA rules fetched by `aeng setup` (Neo23x0/signature-base, DRL)
src/artifact_engine/data/assets/yara/signature-base/
# Community threat lists fetched by `aeng setup` / `aeng update` (MIT, upstream is
# the authority: a copy committed here would be a frozen threat list)
src/artifact_engine/data/assets/awesome/
# LOTTunnels (GPL-3.0), written by `aeng setup` / `update`: never committed (v0.7.102)
src/artifact_engine/data/assets/lottunnels/

# An asset's local additions (v0.7.95): read beside the shipped list, never
# published -- e.g. a product name the repository must not carry.
src/artifact_engine/data/assets/*.local.txt

# Local config: secrets (IRIS token, etc.) and per-machine settings
config.yaml
config.local.yaml

# esentutl repair byproducts (created in the CWD by /p)
*.INTEG.RAW

# Preview builders write their rendered HTML/CSV beside themselves: generated,
# regenerable, and 180K of markup nobody should review in a diff.
tests/_preview/*.html
tests/_preview/*.csv

# The coding assistant's instructions and settings: local, never published
CLAUDE.md
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python 3.13 environment (see README: the 3.10 interpreter crash)
.venv*/
