# Binarios de herramientas externas (se obtienen con `aeng setup`)
src/artifact_engine/tools/
tools/

# Geo assets descargados por `aeng setup` (regenerables, grandes, CC-BY / volatiles)
src/artifact_engine/data/assets/dbip-country-lite.mmdb
src/artifact_engine/data/assets/dbip-asn-lite.mmdb
src/artifact_engine/data/assets/tor-exit-nodes.txt
# Sello del corte mensual que `aeng update` deja junto a cada mmdb (ver _fetch_dbip)
src/artifact_engine/data/assets/*.mmdb.ym

# Reglas YARA de la comunidad descargadas por `aeng setup` (Florian/signature-base, DRL)
src/artifact_engine/data/assets/yara/signature-base/
# Community threat lists fetched by `aeng setup` / `aeng update` (MIT, upstream is
# the authority: a copy committed here would be a frozen threat list)
src/artifact_engine/data/assets/awesome/

# Config local con secretos (token IRIS, etc.) y ajustes por máquina
config.yaml
config.local.yaml

# esentutl repair byproducts (created in the CWD by /p)
*.INTEG.RAW

# Preview builders write their rendered HTML/CSV beside themselves: generated,
# regenerable, and 180K of markup nobody should review in a diff.
tests/_preview/*.html
tests/_preview/*.csv

# Instrucciones y ajustes del asistente: locales, nunca parte del repo publicado
CLAUDE.md
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python 3.13 environment (see README: the 3.10 interpreter crash)
.venv*/
